{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeriHub",
  "version": "0.2.0",
  "identifier": "io.github.hexdump.perihub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PeriHub",
        "width": 1160,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": { "files": { "/usr/lib/udev/rules.d/70-perihub.rules": "../../packaging/linux/70-perihub.rules" } },
      "rpm": { "files": { "/usr/lib/udev/rules.d/70-perihub.rules": "../../packaging/linux/70-perihub.rules" } }
    }
  }
}
